            "description": "The server failed; the body names no internals.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/orgs/{org}/repos/{repo}/files/{path}": {
      "get": {
        "summary": "Read a file at `main`: its kind and a grant to download its content.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The organisation's name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "description": "The repository's name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "path",
            "required": true,
            "description": "A file path: components separated by `/`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "400": {
            "description": "A name, path, address or body is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid bearer token was presented.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not read the path; the body names it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The repository or the file does not exist, or the caller may not read the repository.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "The server failed; the body names no internals.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/v1/orgs/{org}/repos/{repo}/history/{path}": {
      "get": {
        "summary": "The versions of a path, newest first.",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "description": "The organisation's name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "description": "The repository's name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "path",
            "required": true,
            "description": "A file path: components separated by `/`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "at",
            "in": "query",
            "required": false,
            "description": "A changeset address; the history is as of it, and as of `main` where absent.",
            "schema": {
              "$ref": "#/components/schemas/Address"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "400": {
            "description": "A name, path, address or body is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid bearer token was presented.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The caller may not read the path; the body names it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The repository or the changeset does not exist, or the caller may not read the repository.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "The server failed; the body names no internals.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The paths a 403 or a 409 is about."
          }
        }
      },
      "Address": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "description": "The SHA-256 address of an object."
      },
      "Name": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "Kind": {
        "type": "string",
        "enum": [
          "regular",
          "executable"
        ]
      },
      "NewName": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          }
        }
      },
      "Created": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          }
        }
      },
      "Principal": {
        "type": "object",
        "required": [
          "issuer",
          "subject"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "issuer",
          "subject",
          "role"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        }
      },
      "Grant": {
        "type": "object",
        "required": [
          "issuer",
          "subject",
          "prefix",
          "access"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "prefix": {
            "type": "string",
            "description": "The directory the grant covers, components separated by `/`; empty for the whole repository."
          },
          "access": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ],
            "description": "`write` includes `read`."
          }
        }
      },
      "Upload": {
        "type": "object",
        "required": [
          "address",
          "size"
        ],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "StagedFile": {
        "type": "object",
        "required": [
          "kind",
          "content"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "content": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Landing": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "Landed": {
        "type": "object",
        "required": [
          "changeset"
        ],
        "properties": {
          "changeset": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "TransferGrant": {
        "type": "object",
        "required": [
          "url",
          "method",
          "headers",
          "expires_at"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "PUT"
            ]
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "expires_at": {
            "type": "integer",
            "description": "Seconds since 1970-01-01T00:00:00Z."
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "kind",
          "download"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "download": {
            "$ref": "#/components/schemas/TransferGrant"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "changeset",
          "path",
          "kind",
          "content",
          "previous"
        ],
        "properties": {
          "changeset": {
            "$ref": "#/components/schemas/Address"
          },
          "path": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "content": {
            "$ref": "#/components/schemas/Address"
          },
          "previous": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          }
        }
      },
      "History": {
        "type": "object",
        "required": [
          "versions"
        ],
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          }
        }
      }
    }
  }
}
